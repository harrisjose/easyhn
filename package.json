{
  "name": "easyhn",
  "description": "A clean, readable, cross-browser UI for Hacker News",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "author": "Harris Jose (https://x.com/harrispjose)",
  "license": "MIT",
  "homepage": "https://github.com/harrisjose/easyhn#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/harrisjose/easyhn.git"
  },
  "bugs": {
    "url": "https://github.com/harrisjose/easyhn/issues"
  },
  "scripts": {
    "predev": "node -e \"require('fs').mkdirSync('.wxt/chrome-profile',{recursive:true})\"",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "install-local": "wxt build && node scripts/install-local.mjs",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "release-patch": "npm version patch && git push --follow-tags",
    "release-minor": "npm version minor && git push --follow-tags",
    "release-major": "npm version major && git push --follow-tags",
    "compile": "tsc --noEmit",
    "test": "tsx tests/parse.test.ts",
    "test:fixtures": "tsx tests/fetch-fixtures.ts",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@wxt-dev/module-react": "^1.1.3",
    "jsdom": "^29.1.1",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0",
    "wxt": "^0.20.0"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
