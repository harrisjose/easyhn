.DS_Store

# Installed agent skills and their lockfile — tooling, not part of the
# extension. .claude/skills holds symlinks into .agents/skills.
.agents/skills/
.claude/skills/
skills-lock.json

# Personal editor/agent settings. A shared .claude/settings.json is still
# committable if we ever want one.
.claude/settings.local.json

# Store listing screenshots — generated by store/screenshots.html from
# landing/public/card-*.jpg and store/raw/. Regenerate per store/README.md
# rather than diffing binaries in git.
store/screenshots/*.png
store/raw/*.jpg
store/raw/*.png
